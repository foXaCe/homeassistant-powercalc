{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "labels": [
    "dependencies"
  ],
  "ignoreDeps": [
    "python"
  ],
  "dependencyDashboard": false,
  "packageRules": [
    {
      "groupName": "GitHub Actions",
      "matchManagers": [
        "github-actions"
      ]
    },
    {
      "groupName": "all non-major dependencies",
      "groupSlug": "all-minor-patch",
      "matchPackagePatterns": [
        "*"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ]
    },
    {
      "matchManagers": [
        "pip_requirements"
      ],
      "matchFileNames": [
        "pyproject.toml"
      ],
      "enabled": true
    },
    {
      "description": "Tout ce qui monte se fusionne seul quand la CI est verte (opérateur, 2026-10-14)",
      "matchUpdateTypes": [
        "minor",
        "major"
      ],
      "automerge": true,
      "platformAutomerge": true
    }
  ],
  "rollbackPrs": false
}
